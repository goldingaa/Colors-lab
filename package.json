  },
  "homepage": "https://github.com/goldingaa/Colors-lab#readme",
  "devDependencies": {
    "eslint": "^8.57.1",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
